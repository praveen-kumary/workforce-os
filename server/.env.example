# ─── Unified Workforce OS — Environment Configuration ────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Server Port
PORT=4000

# Environment (development | production | test)
NODE_ENV=development

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://uos_user:uos_password@localhost:5432/uos_db?schema=public"

# Redis URL (used for token blacklisting, rate limiting, BullMQ job queues)
REDIS_URL="redis://localhost:6379"

# JWT Secrets — MUST be at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_generate_a_secure_random_string_min_32_chars"
JWT_REFRESH_SECRET="CHANGE_ME_generate_a_different_secure_random_string"

# Token Expiry Durations
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# CORS — comma-separated list of allowed origins
CORS_ORIGIN="http://localhost:5173"

# Logging Level (debug | info | warn | error)
LOG_LEVEL="debug"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"
